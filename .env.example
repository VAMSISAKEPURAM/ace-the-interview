# =====================================================================
# ACE THE INTERVIEW / VOICE CHATBOT - ENVIRONMENT TEMPLATE (.env.example)
# =====================================================================

# 1. GROQ CREDENTIALS (Required for LLM response generation)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. HUGGING FACE CREDENTIALS (Optional - for gated HF models / downloads)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# 3. GROQ LLM MODEL SETTINGS
GROQ_MODEL_NAME=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=300
LLM_TIMEOUT=15

# 4. HUGGING FACE STT & TTS SETTINGS
HF_STT_MODEL_NAME=openai/whisper-base
STT_DEVICE=cpu
STT_LANGUAGE=en
HF_TTS_MODEL_NAME=facebook/mms-tts-eng
TTS_DEVICE=cpu

# 5. AUDIO PARAMETERS
SAMPLE_RATE=16000
CHANNELS=1
DEFAULT_RECORD_DURATION=5
SILENCE_THRESHOLD=0.01
SILENCE_DURATION=1.5

# 6. CONVERSATION & LOGGING
MAX_HISTORY_MESSAGES=10
LOG_LEVEL=INFO
